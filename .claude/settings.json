{
  "includeCoAuthoredBy": false,
  "cleanupPeriodDays": 14,
  "env": {
    "CLAUDE_CODE_MAX_OUTPUT_TOKENS": "32000"
  },
  "permissions": {
    "allow": [
      "Read(**)",
      "Search(**)",
      "Explore(**)",
      "Skill(*)",
      "Bash"
    ],
    "deny": [
      "Bash(rm)",
      "Bash(rmdir)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(./secrets/**)"
    ]
  },
  "plansDirectory": "./plans"
}